<div class="main-gird-posts">
  <%if((typeof currentCategory !== 'undefined' && currentCategory) || (typeof locals !== 'undefined' && locals.currentCategory)){%>
    <% const activeCategory = currentCategory || (locals && locals.currentCategory); %>
    <div style="padding: 15px; background: #e3f2fd; margin-bottom: 20px; border-radius: 5px; border-right: 4px solid #2196f3;">
      <strong style="color: #1976d2;">✅ فیلتر فعال:</strong> 
      <span style="color: #424242;">دسته‌بندی "<%=activeCategory%>"</span>
      <a href="/" style="margin-right: 15px; color: #d32f2f; text-decoration: none; font-weight: bold;">❌ حذف فیلتر</a>
    </div>
  <%}%>
  <div class="main-post">
    <%if(posts && posts.length > 0){%>
      <%for(let post of posts){%>
      <a href="/post/<%=post._id%>" class="post-link">
        <article>
          <div class="main-post-detail">
            <h2 class="main-post-title"><%=post.title%></h2>
            <div class="main-post-price"><%=post.amount%> تومان</div>
            <div class="main-post-time">
              <%=moment(post.createdAt).locale("fa").format(`jDD jMMMM HH:mm`)%>
            </div>
          </div>
          <div class="main-post-thumbnail">
            <%if(post.images && post.images.length > 0){%>
              <img src="/<%=post.images[0]%>" alt="<%=post.title%>" />
            <%}else{%>
              <img src="/home/img/cardImg.webp" alt="تصویر پیش‌فرض" />
            <%}%>
          </div>
        </article>
      </a>
      <%}%>
    <%}else{%>
      <div style="text-align: center; padding: 40px; color: #666;">
        <p style="font-size: 18px; margin-bottom: 10px;">هیچ آگهی‌ای یافت نشد</p>
        <p style="font-size: 14px; color: #999;">می‌توانید اولین آگهی را ثبت کنید</p>
      </div>
    <%}%>
  </div>
</div>
